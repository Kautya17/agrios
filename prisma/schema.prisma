// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ENGINEER
  INVESTOR
  ADMIN
}

enum ListingStatus {
  PENDING
  SITE_VISIT_SCHEDULED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  LAND_PHOTO
  WATER_SOURCE_PHOTO
  SEVEN_TWELVE_EXTRACT
  OTHER
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  phone     String?
  roles     Role[]   @default([])
  createdAt DateTime @default(now())

  landListings LandListing[] @relation("OwnerListings")
  siteVisits   SiteVisit[]   @relation("EngineerVisits")
  investments  Investment[]  @relation("InvestorInvestments")
}

model LandListing {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation("OwnerListings", fields: [ownerId], references: [id])
  location    String
  latitude    Float?
  longitude   Float?
  areaAcres   Float
  waterSource String?
  status      ListingStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  documents LandDocument[]
  siteVisit SiteVisit?
  cropPlan  CropPlan?
  updates   ProjectUpdate[]
}

model LandDocument {
  id        String       @id @default(cuid())
  listingId String
  listing   LandListing  @relation(fields: [listingId], references: [id])
  type      DocumentType
  url       String
  createdAt DateTime     @default(now())
}

model SiteVisit {
  id          String      @id @default(cuid())
  listingId   String      @unique
  listing     LandListing @relation(fields: [listingId], references: [id])
  engineerId  String
  engineer    User        @relation("EngineerVisits", fields: [engineerId], references: [id])
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
}

model CropPlan {
  id                   String      @id @default(cuid())
  listingId            String      @unique
  listing              LandListing @relation(fields: [listingId], references: [id])
  cropName             String
  durationMonths       Int
  investmentRequired   Float
  ownerFixedPayout     Float
  investorReturnMinPct Float
  investorReturnMaxPct Float
  marketProjection     String
  productionProjection String
  riskPercent          Float
  createdAt            DateTime    @default(now())
}

model Investment {
  id         String           @id @default(cuid())
  listingId  String
  investorId String
  investor   User             @relation("InvestorInvestments", fields: [investorId], references: [id])
  amount     Float
  status     InvestmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
}

model ProjectUpdate {
  id        String      @id @default(cuid())
  listingId String
  listing   LandListing @relation(fields: [listingId], references: [id])
  title     String
  note      String?
  photoUrl  String?
  createdAt DateTime    @default(now())
}